                else "Exempt"
            )
            limit_scope = "Exempt"
        else:
            limit_scope = "Default" if matched_limit.get("scope") == "default" else "Custom"
            status_text = (
                f"Blocked ({limit_scope}) for {format_duration_seconds(quota.get('retry_after_seconds'))}"
                if quota and not quota.get("allowed", True)
                else f"Within {limit_scope} limit"
                if matched_limit
                else "No limit"
            )
        proxy_types = ", ".join(client["proxy_types"]) if client["proxy_types"] else "none yet"
        last_seen_at = client["last_seen_at"] or "waiting for first request"
        rows.append(
            "<tr>"
            f"<td>{html.escape(client['client'])}</td>"
            f"<td>{client['active_connections']}</td>"
            f"<td>{client['count']}</td>"
            f"<td>{html.escape(proxy_types)}</td>"
            f"<td>{html.escape(format_mb(used_1h))}</td>"
            f"<td>{html.escape(format_mb(limit_1h) if limit_1h is not None else 'none')}</td>"
            f"<td>{html.escape(format_mb(used_3h))}</td>"
            f"<td>{html.escape(format_mb(limit_3h) if limit_3h is not None else 'none')}</td>"
            f"<td>{html.escape(status_text)}</td>"
            f"<td>{html.escape(format_mb(client['uploaded_bytes']))}</td>"
            f"<td>{html.escape(format_mb(client['downloaded_bytes']))}</td>"
            f"<td>{html.escape(format_mb(client['total_bytes']))}</td>"
            f"<td>{html.escape(last_seen_at)}</td>"
            "</tr>"
        )
    return (
        "<div class='table-wrap'>"
        "<table><thead><tr>"
        "<th>Client IP</th><th>Active</th><th>Handled</th><th>Proxy types</th>"
        "<th>Last 1h</th><th>Limit 1h</th><th>Last 3h</th><th>Limit 3h</th><th>Status</th>"
        "<th>Upload</th><th>Download</th><th>Total</th><th>Last seen</th>"
        "</tr></thead>"
        f"<tbody>{''.join(rows)}</tbody></table>"
        "</div>"
    )


def render_latest_request(snapshot) -> str:
    latest = snapshot["latest_request"]
    if latest is None:
        return "<div class='empty'>No completed requests yet.</div>"

    fields = [
        ("Time", latest["timestamp"]),
        ("Proxy", latest["proxy_type"]),
        ("Method", latest["method"]),
        ("Client", latest["client"]),
        ("Destination", latest["destination"]),
        ("Route", latest.get("route_label", "direct")),
        ("Upload", format_mb(latest["uploaded_bytes"])),
        ("Download", format_mb(latest["downloaded_bytes"])),
        ("Total", format_mb(latest["total_bytes"])),
    ]
    items = []
    for label, value in fields:
        items.append(
            "<div class='detail-row'>"
            f"<span class='detail-label'>{html.escape(label)}</span>"
            f"<span class='detail-value'>{html.escape(str(value))}</span>"
            "</div>"
        )
    return "".join(items)


def render_recent_requests(snapshot) -> str:
    if not snapshot["recent_requests"]:
        return "<div class='empty'>No recent requests yet.</div>"

    rows = []
    for request in snapshot["recent_requests"]:
        rows.append(
            "<tr>"
            f"<td>{html.escape(request['timestamp'])}</td>"
            f"<td>{html.escape(request['proxy_type'])}</td>"
            f"<td>{html.escape(request['method'])}</td>"
            f"<td>{html.escape(request['client'])}</td>"
            f"<td class='destination'>{html.escape(request['destination'])}</td>"
            f"<td>{html.escape(request.get('route_label', 'direct'))}</td>"
            f"<td>{html.escape(format_mb(request['total_bytes']))}</td>"
            "</tr>"
        )
    return (
        "<table><thead><tr><th>Time</th><th>Proxy</th><th>Method</th><th>Client</th>"
        "<th>Destination</th><th>Route</th><th>Total</th></tr></thead>"
        f"<tbody>{''.join(rows)}</tbody></table>"
    )


def render_recent_failures(snapshot) -> str:
    failure_summary = snapshot.get("failure_summary") or {
        "grouped_visible": [],
        "grouped_ignored": [],
        "visible_total": 0,
        "ignored_total": 0,
        "page_size": FAILURE_PAGE_SIZE,
    }
    groups = failure_summary.get("grouped_visible", [])
    if not groups:
        if failure_summary.get("grouped_ignored"):
            return "<div class='empty'>All failed domains are currently ignored.</div>"
        return "<div class='empty'>No failed requests recorded yet.</div>"

    rows = []
    for group in groups[:FAILURE_PAGE_SIZE]:
        domain = group.get("domain") or group["group_key"]
        latest_host = group.get("host") or ""
        host_count = int(group.get("host_count") or 0)
        rows.append(
            "<tr>"
            f"<td>{html.escape(group['latest_timestamp'])}</td>"
            f"<td class='destination'><strong>{html.escape(domain)}</strong><br>"
            f"<span class='muted'>{host_count} host(s) · latest {html.escape(latest_host or domain)}</span></td>"
            f"<td>{group['count']}</td>"
            f"<td>{html.escape(', '.join(group.get('method_list', [])))}</td>"
            f"<td>{group.get('client_count', 0)}</td>"
            f"<td>{html.escape(group.get('route_label', 'direct'))}</td>"
            f"<td>{html.escape(group['latest_error'])}</td>"
            "</tr>"
        )
    return (
        "<table><thead><tr><th>Latest</th><th>Domain</th><th>Count</th><th>Methods</th>"
        "<th>Clients</th><th>Route</th><th>Latest error</th></tr></thead>"
        f"<tbody>{''.join(rows)}</tbody></table>"
    )


def format_chart_timestamp_label(timestamp: str) -> str:
    try:
        return datetime.fromisoformat(timestamp).strftime("%H:%M:%S")
    except ValueError:
        return timestamp


def build_usage_chart_points(snapshot, limit: int = 12):
    recent_requests = snapshot.get("recent_requests", [])
    if not recent_requests:
        return []

    points = []
    for request in reversed(recent_requests[:limit]):
        points.append(
            {
                "label": format_chart_timestamp_label(request["timestamp"]),
                "uploaded_bytes": int(request["uploaded_bytes"]),
                "downloaded_bytes": int(request["downloaded_bytes"]),
                "total_bytes": int(request["total_bytes"]),
            }
        )
    return points


def render_usage_chart(snapshot) -> str:
    points = build_usage_chart_points(snapshot)
    if not points:
        return "<div class='empty'>No recent traffic yet.</div>"

    svg_width = 720
    svg_height = 220
    padding_top = 14
    padding_right = 12
    padding_bottom = 40
    padding_left = 12
    inner_width = svg_width - padding_left - padding_right
    inner_height = svg_height - padding_top - padding_bottom
    slot_width = inner_width / len(points)
    bar_width = min(max(slot_width * 0.58, 10), 34)
    max_total = max(point["total_bytes"] for point in points) or 1
    tick_every = max(1, (len(points) + 2) // 4)

    bars = []
    labels = []
    for index, point in enumerate(points):
        x = padding_left + (slot_width * index) + ((slot_width - bar_width) / 2)
        download_height = (point["downloaded_bytes"] / max_total) * inner_height
        upload_height = (point["uploaded_bytes"] / max_total) * inner_height
        y_base = padding_top + inner_height
        download_y = y_base - download_height
        upload_y = download_y - upload_height

        bars.append(
            f"<rect class='chart-download' x='{x:.2f}' y='{download_y:.2f}' "
            f"width='{bar_width:.2f}' height='{download_height:.2f}' rx='5' ry='5'>"
            f"<title>{html.escape(point['label'])} download {format_mb(point['downloaded_bytes'])}</title>"
            "</rect>"
        )
        if upload_height > 0:
            bars.append(
                f"<rect class='chart-upload' x='{x:.2f}' y='{upload_y:.2f}' "
                f"width='{bar_width:.2f}' height='{upload_height:.2f}' rx='5' ry='5'>"
                f"<title>{html.escape(point['label'])} upload {format_mb(point['uploaded_bytes'])}</title>"
                "</rect>"
            )

        if index % tick_every == 0 or index == len(points) - 1:
            labels.append(
                f"<text class='chart-label' x='{x + (bar_width / 2):.2f}' y='{svg_height - 14}' "
                f"text-anchor='middle'>{html.escape(point['label'])}</text>"
            )

    return (
        "<div class='chart-shell'>"
        "<div class='chart-legend'>"
        "<span><i class='legend-swatch legend-upload'></i>Upload</span>"
        "<span><i class='legend-swatch legend-download'></i>Download</span>"
        "</div>"
        f"<svg class='usage-chart-svg' viewBox='0 0 {svg_width} {svg_height}' "
        "role='img' aria-label='Recent traffic by request'>"
        f"<line class='chart-axis' x1='{padding_left}' y1='{padding_top + inner_height}' "
        f"x2='{svg_width - padding_right}' y2='{padding_top + inner_height}'></line>"
        f"{''.join(bars)}"
        f"{''.join(labels)}"
        "</svg>"
        "</div>"
    )


