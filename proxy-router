    async function loadRouterConfig({{ silent = false }} = {{}}) {{
      const response = await fetch("/api/router-config", {{
        cache: "no-store",
        headers: {{
          "Accept": "application/json"
        }}
      }});
      if (!response.ok) {{
        throw new Error(`router config HTTP ${{response.status}}`);
      }}
      const loadedConfig = normalizeRouterConfig(await response.json());
      if (silent && currentRouterIsDirty()) {{
        return;
      }}
      currentRouterConfig = loadedConfig;
      lastSavedRouterConfig = cloneJson(currentRouterConfig);
      syncRouterFormFromState();
      if (!silent) {{
        setRouterStatus(`Loaded from disk · ${{new Date().toLocaleTimeString()}}`);
      }}
    }}

    async function saveRouterConfig() {{
      syncRouterStateFromForm();
      const response = await fetch("/api/router-config", {{
        method: "POST",
        headers: {{
