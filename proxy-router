    function renderRecentFailures(snapshot) {{
      const failureSummary = snapshot.failure_summary || {{ page_size: 10 }};
      const pageSize = failureSummary.page_size || 10;
      const visibleGroups = new Map();
      const ignoredGroups = new Map();
      const handledGroups = new Set();

      (snapshot.recent_failures || []).forEach((failure) => {{
        const host = String(failure.host || "").trim().toLowerCase();
        const domain = summarizeDomain(host);
        const key = domain || host || String(failure.destination || "unknown");
        const disposition = failureDispositionForHost(host || key);
        if (disposition === "handled") {{
          handledGroups.add(key);
          return;
        }}
        const target = disposition === "ignored" ? ignoredGroups : visibleGroups;
        const existing = target.get(key) || {{
          group_key: key,
          domain: domain || key,
          host: host || null,
          latest_timestamp: failure.timestamp,
          latest_error: failure.error,
          latest_destination: failure.destination,
          route_label: failure.route_label || "direct",
          count: 0,
          methods: new Set(),
          clients: new Set(),
          hosts: new Set(),
        }};
        existing.count += 1;
        existing.methods.add(failure.method);
        existing.clients.add(failure.client);
        if (host) {{
          existing.hosts.add(host);
        }}
        if (String(failure.timestamp) >= String(existing.latest_timestamp)) {{
          existing.latest_timestamp = failure.timestamp;
          existing.latest_error = failure.error;
          existing.latest_destination = failure.destination;
          existing.route_label = failure.route_label || "direct";
          existing.host = host || null;
        }}
        target.set(key, existing);
      }});

      const finalizeGroups = (groups) => Array.from(groups.values())
        .map((item) => ({{
          group_key: item.group_key,
          domain: item.domain || item.group_key,
          host: item.host,
          latest_timestamp: item.latest_timestamp,
          latest_error: item.latest_error,
          latest_destination: item.latest_destination,
          route_label: item.route_label,
          count: item.count,
          client_count: item.clients.size,
          method_list: Array.from(item.methods).sort(),
          host_count: item.hosts.size,
          host_list_preview: Array.from(item.hosts).sort().slice(0, 3),
        }}))
        .sort((a, b) => String(b.latest_timestamp).localeCompare(String(a.latest_timestamp)) || (b.count - a.count));

      const groups = finalizeGroups(visibleGroups);
      const ignoredGroupItems = finalizeGroups(ignoredGroups);
      const totalPages = Math.max(1, Math.ceil(groups.length / pageSize));
      currentFailurePage = Math.min(Math.max(1, currentFailurePage), totalPages);
      const startIndex = (currentFailurePage - 1) * pageSize;
      const pageItems = groups.slice(startIndex, startIndex + pageSize);

      failureSummaryNoteElement.textContent = String(groups.length) + " grouped domains shown" +
        (ignoredGroupItems.length ? " · " + String(ignoredGroupItems.length) + " ignored" : "") +
        (handledGroups.size ? " · " + String(handledGroups.size) + " handled by local rules" : "");
      ignoredFailuresNoteElement.textContent = ignoredGroupItems.length
        ? "Ignored domains: " + ignoredGroupItems.map((item) => item.domain || item.group_key).join(", ")
        : "";
      failurePageLabel.textContent = "Page " + String(currentFailurePage) + " / " + String(totalPages);
      failurePrevButton.disabled = currentFailurePage <= 1;
      failureNextButton.disabled = currentFailurePage >= totalPages;

      if (!pageItems.length) {{
        recentFailuresElement.innerHTML = ignoredGroupItems.length
          ? "<div class='empty'>All failed domains are currently ignored.</div>"
          : handledGroups.size
            ? "<div class='empty'>No actionable failed domains remain. Existing local rules already cover them.</div>"
            : "<div class='empty'>No failed requests recorded yet.</div>";
        return;
      }}

      recentFailuresElement.innerHTML = `
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Latest</th><th>Domain</th><th>Count</th><th>Methods</th><th>Clients</th><th>Route</th><th>Latest error</th><th>Actions</th></tr>
            </thead>
            <tbody>
              ${{pageItems.map((group) => `
                <tr>
                  <td>${{escapeHtml(group.latest_timestamp)}}</td>
                  <td class="destination">
                    <strong>${{escapeHtml(group.domain || group.group_key)}}</strong><br>
                    <span class="muted">${{group.host_count}} host(s) · latest ${{escapeHtml(group.host || group.domain || group.group_key)}}</span>
                  </td>
                  <td>${{group.count}}</td>
                  <td>${{escapeHtml((group.method_list || []).join(", "))}}</td>
                  <td>${{group.client_count}}</td>
                  <td>${{escapeHtml(group.route_label || "direct")}}</td>
                  <td>${{escapeHtml(group.latest_error)}}</td>
                  <td class="rule-actions">
                    <button type="button" data-failure-pattern="${{escapeHtml(group.domain || group.group_key)}}" data-rule-match="suffix" data-rule-action="proxy">Proxy domain</button>
                    ${{group.host && group.host !== group.domain
                      ? `<button type="button" data-failure-pattern="${{escapeHtml(group.host)}}" data-rule-match="exact" data-rule-action="proxy">Proxy exact host</button>`
                      : ""}}
                    <button type="button" data-failure-pattern="${{escapeHtml(group.domain || group.group_key)}}" data-rule-match="suffix" data-rule-action="direct">Direct domain</button>
                    <button class="warn" type="button" data-failure-pattern="${{escapeHtml(group.domain || group.group_key)}}" data-rule-match="suffix" data-rule-action="block">Block domain</button>
                    <button class="warn" type="button" data-ignore-host="${{escapeHtml(group.domain || group.group_key)}}">Ignore</button>
                  </td>
                </tr>
              `).join("")}}
            </tbody>
          </table>
        </div>
      `;
    }}

