    function renderEditorTargetOptions() {{
      ensureEditorTargetExists();
      const options = [
        `<option value="${{DEFAULT_ROUTING_PROFILE_ID}}">Shared</option>`,
        ...(currentRouterConfig.routing_profiles || []).map((profile) => `
          <option value="${{escapeHtml(profile.id)}}">${{escapeHtml(profile.name)}}</option>
        `),
      ];
      routerEditorTargetElement.innerHTML = options.join("");
      routerEditorTargetElement.value = currentEditorProfileId;
      if (routerEditorTargetElement.value !== currentEditorProfileId) {{
        currentEditorProfileId = DEFAULT_ROUTING_PROFILE_ID;
        routerEditorTargetElement.value = currentEditorProfileId;
      }}
    }}

    function renderRouterSummary() {{
      const currentTarget = getCurrentEditorTarget();
      const visibleRuleEntries = getEditorVisibleRuleEntries();
      const enabledRules = visibleRuleEntries.filter((entry) => entry.rule && entry.rule.enabled).length;
      const enabledClientLimits = currentRouterConfig.client_traffic_limits.filter((limit) => limit.enabled).length;
      const enabledClientExemptions = currentRouterConfig.client_traffic_exemptions.filter((exemption) => exemption.enabled).length;
      const defaultClientLimit = currentRouterConfig.default_client_traffic_limit || {{}};
      const autoProxyStatus = currentRouterConfig.auto_proxy_failures.enabled
        ? AUTO_PROXY_POLICY_LABEL
