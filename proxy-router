          <td><input type="text" data-field="pattern" value="${{escapeHtml(rule.pattern)}}" placeholder="gigabyte.com" ${{rule.source === "auto" ? "disabled class='rule-readonly'" : ""}}></td>
          <td>
            <select data-field="match" ${{rule.source === "auto" ? "disabled class='rule-readonly'" : ""}}>
              <option value="suffix" ${{rule.match === "suffix" ? "selected" : ""}}>Suffix</option>
              <option value="exact" ${{rule.match === "exact" ? "selected" : ""}}>Exact</option>
              <option value="contains" ${{rule.match === "contains" ? "selected" : ""}}>Contains</option>
            </select>
          </td>
          <td>
            <select data-field="action" ${{rule.source === "auto" ? "disabled class='rule-readonly'" : ""}}>
              <option value="direct" ${{rule.action === "direct" ? "selected" : ""}}>Direct</option>
              <option value="proxy" ${{rule.action === "proxy" ? "selected" : ""}}>Proxy</option>
              <option value="block" ${{rule.action === "block" ? "selected" : ""}}>Block</option>
            </select>
          </td>
          <td>
            <div class="rule-meta">
              <span class="rule-pill ${{rule.source === "auto" ? "rule-pill-auto" : ""}}">${{rule.source === "auto" ? "Auto" : "Manual"}}</span>
              ${{rule.source === "auto" ? "<small>Auto-managed</small>" : "<small>User-managed</small>"}}
            </div>
          </td>
          <td>
            ${{renderRuleDurationCell(rule)}}
          </td>
          <td><input type="text" data-field="note" value="${{escapeHtml(rule.note)}}" placeholder="optional note" ${{rule.source === "auto" ? "disabled class='rule-readonly'" : ""}}></td>
          <td class="rule-actions">
            <button type="button" data-action="${{rule.source === "auto" ? "ignore" : "delete"}}">${{rule.source === "auto" ? "Ignore" : "Delete"}}</button>
          </td>
        </tr>
      `;
      }}).join("");

