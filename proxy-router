      const runtime = currentRouterRuntime();
      const activeProfile = runtime.active_profile || {{}};
      const activeProfileConfig = (currentRouterConfig.routing_profiles || []).find((profile) => profile.id === activeProfile.id);
      const editorTargetLabel = currentEditorProfileId === DEFAULT_ROUTING_PROFILE_ID
        ? "Shared"
