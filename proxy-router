    function syncRouterFormFromState() {{
      currentRouterConfig = normalizeRouterConfig(currentRouterConfig);
      ensureEditorTargetExists();
      const currentTarget = getCurrentEditorTarget();
      upstreamEnabledElement.checked = currentRouterConfig.upstream.enabled;
      upstreamTypeElement.value = currentRouterConfig.upstream.type;
      upstreamHostElement.value = currentRouterConfig.upstream.host;
      upstreamPortElement.value = currentRouterConfig.upstream.port;
      defaultActionElement.value = currentTarget.default_action;
      autoProxyEnabledElement.checked = currentRouterConfig.auto_proxy_failures.enabled;
      defaultClientLimitEnabledElement.checked = currentRouterConfig.default_client_traffic_limit.enabled;
      defaultClientLimit1hElement.value = currentRouterConfig.default_client_traffic_limit.max_past_hour_mb ?? "";
      defaultClientLimit3hElement.value = currentRouterConfig.default_client_traffic_limit.max_past_3h_mb ?? "";
      defaultClientLimitNoteElement.value = currentRouterConfig.default_client_traffic_limit.note || "";

      const orderedRules = getEditorVisibleRuleEntries()
        .filter((entry) => ruleMatchesSearch({{ ...entry.rule, scope: entry.scope_label }}, currentRulesSearchTerm))
        .sort((left, right) => {{
          const scopeRankLeft = left.scope === currentEditorProfileId ? 0 : 1;
          const scopeRankRight = right.scope === currentEditorProfileId ? 0 : 1;
          if (scopeRankLeft !== scopeRankRight) {{
            return scopeRankLeft - scopeRankRight;
          }}
          const leftRank = left.rule.source === "auto" ? 1 : 0;
          const rightRank = right.rule.source === "auto" ? 1 : 0;
          if (leftRank !== rightRank) {{
            return leftRank - rightRank;
          }}
          return left.index - right.index;
        }});
      const totalRulePages = Math.max(1, Math.ceil(orderedRules.length / RULES_PAGE_SIZE));
      currentRulesPage = Math.min(Math.max(1, currentRulesPage), totalRulePages);
      const ruleStartIndex = (currentRulesPage - 1) * RULES_PAGE_SIZE;
      const pagedRules = orderedRules.slice(ruleStartIndex, ruleStartIndex + RULES_PAGE_SIZE);
      const allRulesCount = getEditorVisibleRuleEntries().length;
      rulesSummaryNoteElement.textContent = orderedRules.length
        ? currentRulesSearchTerm
          ? `${{orderedRules.length}} of ${{allRulesCount}} rules match`
          : `${{orderedRules.length}} total rules`
        : currentRulesSearchTerm
          ? `No rules match "${{currentRulesSearchTerm}}".`
          : "No rules yet.";
      rulesPageLabel.textContent = "Page " + String(currentRulesPage) + " / " + String(totalRulePages);
      rulesPrevButton.disabled = currentRulesPage <= 1;
      rulesNextButton.disabled = currentRulesPage >= totalRulePages;

      routerRulesBodyElement.innerHTML = pagedRules.map((entry) => {{
